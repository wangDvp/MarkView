    "test:package": "python3 tests/test_release_package.py",
    "test:native": "python3 tests/native/test_save.py && node tests/native/bridge.mjs && python3 tests/native/verify_launcher.py",
    "test:native:browser": "node tests/native/browser.mjs",
    "package": "python3 scripts/package-release.py",
    "test": "npm run build && node tests/e2e.mjs"
  },
