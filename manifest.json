{
  "manifest_version": 3,
  "name": "Markdown 预览 · Ctrl+M",
  "version": "1.1.0",
  "description": "本地 Markdown 预览与左右分栏编辑，支持保存、另存为、Word 和 PDF 导出；Ctrl+M 切换预览。",
  "minimum_chrome_version": "123",
  "permissions": ["storage", "nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Markdown 预览 (Ctrl+M)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-preview": {
      "suggested_key": {
        "default": "Ctrl+M",
        "mac": "MacCtrl+M"
      },
      "description": "切换 Markdown 预览 / 原始文本"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["pdf-export.js", "pdf-content.js", "lib/pdf-vendor.js", "fonts/NotoSansSC-Regular.otf", "fonts/NotoSansSC-Bold.otf"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*.md*",
        "http://*/*.MD*",
        "http://*/*.Md*",
        "http://*/*.markdown*",
        "http://*/*.MARKDOWN*",
        "http://*/*.Markdown*",
        "https://*/*.md*",
        "https://*/*.MD*",
        "https://*/*.Md*",
        "https://*/*.markdown*",
        "https://*/*.MARKDOWN*",
        "https://*/*.Markdown*"
      ],
      "js": ["lib/markdown-vendor.js", "renderer.js", "native-file.js", "document-export.js", "document-editor.js", "lib/content-styles.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "file:///*.md*",
        "file:///*.MD*",
        "file:///*.Md*",
        "file:///*.markdown*",
        "file:///*.MARKDOWN*",
        "file:///*.Markdown*"
      ],
      "js": ["lib/markdown-vendor.js", "renderer.js", "native-file.js", "document-export.js", "document-editor.js", "lib/content-styles.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
